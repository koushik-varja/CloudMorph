# Copy to .env before Docker Compose. This is a local-development example only.
POSTGRES_PASSWORD=replace-with-a-local-password
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
CLOUDMORPH_SEED=42
# For non-Compose development the backend defaults to SQLite.
# You may override DATABASE_URL with your own PostgreSQL URL.
